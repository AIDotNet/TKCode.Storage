  "version": "0.1.0",
  "description": "显示正在播放的音乐，控制播放",
  "icon": "Music",
  "engines": {
    "island": "^1.0.0"
  },
  "main": "main.js",
  "permissions": [
    "media"
  ],
  "contributes": {
