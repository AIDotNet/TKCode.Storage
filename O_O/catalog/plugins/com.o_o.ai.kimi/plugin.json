{
  "id": "com.o_o.ai.kimi",
  "name": "Kimi 余额",
  "version": "0.1.0",
  "description": "用 API Key 查询 Kimi（Moonshot）余额",
  "icon": "Wallet",
  "main": "main.js",
  "permissions": [
    "network:api.moonshot.cn",
    "network:api.moonshot.ai"
  ],
  "contributes": {
    "providers": [
      {
        "interface": "ai-usage",
        "id": "kimi",
        "title": "Kimi"
      }
    ],
    "settings": {
      "properties": {
        "region": {
          "type": "string",
          "title": "站点",
          "description": "中国站 platform.moonshot.cn（人民币）；国际站 platform.moonshot.ai（美元）。所有 Key 使用同一站点。",
          "enum": [
            "中国站",
            "国际站"
          ],
          "default": "中国站"
        },
        "key1": {
          "type": "string",
          "format": "password",
          "title": "API Key",
          "description": "在 Kimi 开放平台的“API Key 管理”页创建。只保存在系统钥匙串里，只发送给所选站点的 API。"
        },
        "name1": {
          "type": "string",
          "title": "名称",
          "description": "可选，用来区分多个 Key（如“工作”“个人”）。",
          "default": ""
        },
        "key2": {
          "type": "string",
          "format": "password",
          "title": "API Key 2",
          "description": "可选：第二个账户的 Key。"
        },
        "name2": {
          "type": "string",
          "title": "名称 2",
          "default": ""
        },
        "key3": {
          "type": "string",
          "format": "password",
          "title": "API Key 3",
          "description": "可选：第三个账户的 Key。"
        },
        "name3": {
          "type": "string",
          "title": "名称 3",
          "default": ""
        }
      }
    }
  }
}
