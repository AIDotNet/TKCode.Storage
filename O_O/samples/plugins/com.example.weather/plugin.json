{
  "id": "com.example.weather",
  "name": "天气（示例）",
  "version": "0.2.0",
  "engines": { "island": "^2.0.0" },
  "main": "main.js",
  "permissions": ["network:api.open-meteo.com"],
  "contributes": {
    "ambient": [{ "id": "temp", "title": "温度", "side": "right" }],
    "home": [{ "id": "now", "title": "天气（示例）", "icon": "CloudSun" }],
    "settings": {
      "properties": {
        "city":      { "type": "string",  "title": "城市", "description": "显示在岛上的名称。", "default": "上海" },
        "latitude":  { "type": "number",  "title": "纬度", "minimum": -90,  "maximum": 90,  "default": 31.23 },
        "longitude": { "type": "number",  "title": "经度", "minimum": -180, "maximum": 180, "default": 121.47 },
        "units":     { "type": "string",  "title": "温度单位", "enum": ["摄氏度", "华氏度"], "default": "摄氏度" },
        "every":     { "type": "integer", "title": "刷新间隔（分钟）", "minimum": 5, "maximum": 120, "default": 15 },
        "showWind":  { "type": "boolean", "title": "显示风速", "default": true }
      }
    }
  }
}
