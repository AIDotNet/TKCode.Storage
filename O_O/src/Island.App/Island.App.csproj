<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <AssemblyName>O_O</AssemblyName>
        <!-- Generated from the mascot by the app itself; see docs/dev.md (render the icon). -->
        <ApplicationIcon>..\..\assets\icon\O_O.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <!-- The .NET 11 SDK's optimized AOT publish drops Avalonia's compiled XAML ("No precompiled XAML found" at start). -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
        <!-- A background accessory: a small heap matters more than GC pauses. No background GC thread, and the GC
             compacts more eagerly instead of growing the heap (ConserveMemory, 0-9). -->
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    </ItemGroup>

    <ItemGroup>
        <!-- First-party plugins ship next to the executable, in plugins/<id>/. -->
        <None Include="..\..\plugins\**\*" LinkBase="plugins" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
        <PackageReference Include="TKCode.Arc" Version="1.1.0-preview.1" />
        <PackageReference Include="TKCode.Arc.Fonts" Version="1.1.0-preview.1" />
        <PackageReference Include="TKCode.Arc.Icons.Lucide" Version="1.1.0-preview.1" />
        <PackageReference Include="TKCode.Arc.Special" Version="1.1.0-preview.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Island.UI\Island.UI.csproj" />
        <ProjectReference Include="..\Island.Plugins.Host\Island.Plugins.Host.csproj" />
        <ProjectReference Include="..\Island.Platform.MacOS\Island.Platform.MacOS.csproj" />
        <ProjectReference Include="..\Island.Platform.Windows\Island.Platform.Windows.csproj" />
        <ProjectReference Include="..\Island.Platform.Linux\Island.Platform.Linux.csproj" />
    </ItemGroup>
</Project>
