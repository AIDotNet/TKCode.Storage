{
  "id": "com.o_o.theme.mono",
  "name": "黑白主题",
  "version": "0.2.0",
  "description": "近乎无彩色的中性强调色，方正一些的圆角",
  "icon": "Contrast",
  "engines": { "island": "^2.0.0" },
  "main": "main.js",
  "optional": true,
  "permissions": [],
  "contributes": {
    "themes": [
      { "id": "mono", "title": "黑白", "description": "中性色，跟随系统的浅色或深色；岛上的活动不着彩色", "accent": "#353535", "corners": 0.4,
        "island": {
          "shape": { "radius": 0.8 },
          "content": { "accents": { "music": "#D1D1D6", "timer": "#D1D1D6", "calendar": "#D1D1D6", "message": "#D1D1D6", "reminder": "#D1D1D6", "warning": "#F2F2F7" } },
          "motion": { "spring": "snappy" } } }
    ]
  }
}
