{
  "id": "com.o_o.mail",
  "name": "邮件",
  "version": "0.1.0",
  "description": "收件箱未读数、新邮件提醒和最近的邮件（只读，IMAP）",
  "icon": "Mail",
  "optional": true,
  "main": "main.js",
  "permissions": ["mail", "shell.openUrl", "oauth:google", "oauth:microsoft"],
  "contributes": {
    "pages": [{ "id": "inbox", "title": "邮件", "icon": "Mail" }],
    "chips": [{ "id": "unread", "title": "未读邮件数", "side": "right" }],
    "settings": {
      "properties": {
        "preset1": { "type": "string", "title": "邮箱 1", "enum": ["QQ 邮箱", "163 邮箱", "126 邮箱", "腾讯企业邮", "阿里邮箱", "iCloud", "Gmail", "Outlook", "自定义"], "default": "QQ 邮箱" },
        "user1": { "type": "string", "title": "邮箱地址", "description": "完整的邮箱地址，如 name@qq.com。", "default": "" },
        "password1": { "type": "string", "format": "password", "title": "授权码 / 应用专用密码", "description": "不是登录密码。QQ / 163 / 126：网页邮箱 设置 › 账户 中开启 IMAP 并生成授权码；iCloud：appleid.apple.com 生成 App 专用密码；Gmail：开启两步验证后在 Google 账号中生成应用专用密码。Outlook 已不支持应用密码，请用下面的 Microsoft 登录。只保存在系统钥匙串里。" },
        "host1": { "type": "string", "title": "服务器（自定义时）", "description": "IMAP 服务器地址，如 imap.example.com；只在选\"自定义\"时使用。O_O 只会连接这里填写的服务器。", "default": "" },
        "port1": { "type": "integer", "title": "端口（自定义时）", "description": "IMAP over SSL，一般是 993。", "minimum": 1, "maximum": 65535, "default": 993 },
        "preset2": { "type": "string", "title": "邮箱 2", "enum": ["QQ 邮箱", "163 邮箱", "126 邮箱", "腾讯企业邮", "阿里邮箱", "iCloud", "Gmail", "Outlook", "自定义"], "default": "163 邮箱" },
        "user2": { "type": "string", "title": "邮箱地址 2", "default": "" },
        "password2": { "type": "string", "format": "password", "title": "授权码 2" },
        "host2": { "type": "string", "title": "服务器 2（自定义时）", "default": "" },
        "port2": { "type": "integer", "title": "端口 2（自定义时）", "minimum": 1, "maximum": 65535, "default": 993 },
        "preset3": { "type": "string", "title": "邮箱 3", "enum": ["QQ 邮箱", "163 邮箱", "126 邮箱", "腾讯企业邮", "阿里邮箱", "iCloud", "Gmail", "Outlook", "自定义"], "default": "自定义" },
        "user3": { "type": "string", "title": "邮箱地址 3", "default": "" },
        "password3": { "type": "string", "format": "password", "title": "授权码 3" },
        "host3": { "type": "string", "title": "服务器 3（自定义时）", "default": "" },
        "port3": { "type": "integer", "title": "端口 3（自定义时）", "minimum": 1, "maximum": 65535, "default": 993 },
        "googleClientId": { "type": "string", "title": "Google 客户端 ID（用 Google 登录 Gmail）", "description": "在 Google Cloud 控制台创建\"桌面应用\"类型的 OAuth 客户端，启用 Gmail API，把客户端 ID 填在这里；填好后在岛上的\"邮件\"页点\"用 Google 登录\"。", "default": "" },
        "googleClientSecret": { "type": "string", "format": "password", "title": "Google 客户端密钥" },
        "microsoftClientId": { "type": "string", "title": "Microsoft 应用 ID（用 Microsoft 登录 Outlook）", "description": "在 Azure 门户\"应用注册\"中新建应用：账户类型选\"任何组织目录中的帐户和个人 Microsoft 帐户\"，平台选\"移动和桌面应用程序\"，重定向 URI 填 http://127.0.0.1:47821/oauth/callback，API 权限添加 Office 365 Exchange Online 的 IMAP.AccessAsUser.All。", "default": "" },
        "every": { "type": "integer", "title": "检查间隔（分钟）", "minimum": 2, "maximum": 60, "default": 3 }
      }
    }
  }
}
