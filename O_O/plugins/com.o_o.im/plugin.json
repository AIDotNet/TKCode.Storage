{
  "id": "com.o_o.im",
  "name": "即时消息",
  "version": "0.2.0",
  "description": "微信、QQ 的新消息提醒：岛上短暂显示来源应用的图标和消息，未读数一直留着",
  "icon": "MessageCircle",
  "optional": true,
  "engines": { "island": "^2.0.0" },
  "main": "main.js",
  "permissions": [
    "notifications.listen:com.tencent.xinWeChat",
    "notifications.listen:com.tencent.qq"
  ],
  "contributes": {
    "activities": [{ "id": "unread", "title": "未读消息", "priority": "passive", "accent": "message" }],
    "settings": {
      "properties": {
        "seconds": {
          "type": "integer",
          "title": "每条提醒显示的秒数",
          "minimum": 1,
          "maximum": 10,
          "default": 4
        },
        "mute": {
          "type": "string",
          "title": "免打扰（发送人或群名，用逗号分隔）",
          "default": ""
        }
      }
    }
  }
}
